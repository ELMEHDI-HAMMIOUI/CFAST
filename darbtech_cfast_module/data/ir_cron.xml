<odoo>
    <data noupdate="1">

        <record id="ir_cron_cfast_refresh_token" model="ir.cron">
            <field name="name">CFast Token Refresh</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_token()</field>

            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>

            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">5</field>
        </record>

        <record id="ir_cron_cfast_sync_quotations" model="ir.cron">
            <field name="name">CFAST Quotations Sync</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_cfast_quotations()</field>

            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>

            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_cfast_quotations" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.cfast.quotations</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CFAST"
                      name="cfast_quotations"
                      invisible="not is_company">

                    <group col="4">
                        <group col="2">
                            <button name="action_sync_cfast_quotations"
                                    type="object"
                                    string="Synchroniser Devis CFAST"
                                    class="btn-primary"
                                    icon="fa-refresh"/>
                        </group>

                        <group col="2">
                            <label for="ref"
                                   string="CustomerId envoyé à CFAST"/>

                            <field name="ref"
                                   readonly="1"
                                   placeholder="(référence interne du contact)"/>

                            <field name="cfast_last_sync_datetime"
                                   string="Dernière synchronisation CFAST"
                                   readonly="1"/>
                        </group>
                    </group>

                    <field name="cfast_quotation_log_ids"
                           nolabel="1"
                           readonly="1"
                           context="{
                               'default_partner_id': id,
                               'form_view_ref': 'darbtech_cfast_module.view_cfast_quotation_log_form_wizard'
                           }">

                        <list string="Devis CFAST"
                              create="false"
                              delete="false"
                              edit="false"
                              decoration-success="sync_state in ('order_confirmed','project_generated')"
                              decoration-danger="sync_state == 'error'">

                            <field name="quotation_date"
                                   optional="show"/>

                            <field name="reference"
                                   optional="show"/>

                            <field name="name"
                                   optional="show"/>

                            <field name="quotation_type_name"
                                   string="Type de devis"
                                   optional="show"/>

                            <field name="status"
                                   optional="hide"/>

                            <field name="total_activation_price"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   optional="show"/>

                            <field name="total_periodic_price"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   optional="show"/>

                            <field name="sync_state"
                                   widget="badge"
                                   optional="show"/>

                            <field name="sale_order_id"
                                   optional="show"/>

                            <button name="action_create_sale_order"
                                    type="object"
                                    string="Créer commande"
                                    class="btn-link"
                                    icon="fa-plus"
                                    invisible="sale_order_id"/>

                            <button name="action_open_sale_order"
                                    type="object"
                                    string="Voir commande"
                                    class="btn-link"
                                    icon="fa-external-link"
                                    invisible="not sale_order_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>